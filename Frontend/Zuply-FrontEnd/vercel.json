{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zuply-ja0q.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://zuply-ja0q.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/zuply/browser"
}
